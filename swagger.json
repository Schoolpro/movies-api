    "/auth/google": {
      "get": {
        "tags": [
          "Sesión"
        ],
        "description": "Abrí esta ruta en el navegador para iniciar sesión con Google. No uses Try it out para el login.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": [

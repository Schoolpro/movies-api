            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "El ID o los datos no son válidos"
          },
          "404": {
            "description": "No se encontró el registro"
          },
          "500": {
            "description": "No se pudo completar la solicitud"

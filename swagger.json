          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "No se pudo completar la solicitud"
          }
        }
      },
      "post": {
        "tags": [
          "Películas"
        ],
        "description": "Para agregar, editar o borrar datos, primero iniciá sesión desde /auth/google en este navegador y volvé a esta página.",

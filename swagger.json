  "definitions": {
    "Movie": {
      "type": "object",
      "required": [
        "title",
        "director",
        "year",
        "genre",
        "rating",
        "language",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "example": "Interstellar"
        },
        "director": {
          "type": "string",
          "example": "Christopher Nolan"
        },
        "year": {
          "type": "integer",
          "minimum": 1888,
          "example": 2014
        },
        "genre": {
          "type": "string",
          "example": "Sci-Fi"
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "example": 9
        },
        "language": {
          "type": "string",
          "example": "English"
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "example": 169
        }
      }
    },
    "Director": {
      "type": "object",
      "required": [
        "name",
        "birthYear",
        "nationality",
        "biography"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "example": "Christopher Nolan"
        },
        "birthYear": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2026,
          "example": 1970
        },
        "nationality": {
          "type": "string",
          "example": "British-American"
        },
        "biography": {
          "type": "string",
          "example": "Director y guionista."
        }
      }
    }
  }

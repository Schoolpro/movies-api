          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Completá todos los campos.",
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registro guardado",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Revisá los campos enviados"
          },
          "401": {
            "description": "Falta iniciar sesión"
          },
          "500": {
            "description": "No se pudo completar la solicitud"
          }
        }
